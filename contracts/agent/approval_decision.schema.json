{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dv-agent-approval-decision-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "approval_request_id", "job_id",
    "thread_id", "decision", "approver_identity", "approver_role", "reason",
    "evidence_ids", "candidate_fingerprint", "checkpoint_id", "decided_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "decision_id": {"type": "string", "minLength": 1},
    "approval_request_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "thread_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["APPROVE", "REJECT", "REQUEST_REVISION"]},
    "approver_identity": {"type": "string", "minLength": 1},
    "approver_role": {"enum": ["SPEC_OWNER", "DESIGN_OWNER", "HARDWARE_APPROVER",
      "DV_REVIEWER", "EDA_OWNER"]},
    "reason": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "candidate_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "minLength": 1}
  }
}
