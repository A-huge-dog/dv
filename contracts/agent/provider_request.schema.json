{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dv-agent-provider-request-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "operation", "messages", "tools",
    "tool_choice_policy", "legal_tool_names", "metadata"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "operation": {"enum": ["COMPLETE", "SELECT_TOOLS"]},
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["SYSTEM", "USER", "ASSISTANT"]},
          "content": {"type": "string"}
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "input_schema"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "input_schema": {"type": "object"}
        }
      }
    },
    "tool_choice_policy": {"enum": ["NONE", "AUTO", "REQUIRED", "CONSTRAINED"]},
    "legal_tool_names": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"}
  }
}
